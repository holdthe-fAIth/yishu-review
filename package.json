{
  "name": "yishu-review",
  "private": true,
  "version": "2.1.2",
  "type": "module",
  "description": "一数数学复习 · 目录型进度本（点知识点跳 B站 App，看完回来一键打勾；支持学习时间表、内容更新、发布时间提示）",
  "scripts": {
    "dev": "node scripts/copy-data.mjs && vite",
    "build": "node scripts/copy-data.mjs && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/copy-data.mjs && tsc --noEmit && node scripts/verify-data.mjs && vite build",
    "preview": "vite preview",
    "fetch:data": "node scripts/fetch-data.mjs",
    "enrich:data": "node scripts/enrich-part-counts.mjs",
    "copy:data": "node scripts/copy-data.mjs",
    "verify:data": "node scripts/verify-data.mjs",
    "verify:ui": "node scripts/e2e-check.mjs",
    "screenshot": "node scripts/screenshot.mjs",
    "build:apk": "powershell -ExecutionPolicy Bypass -File scripts/build-apk.ps1"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.3",
    "@capacitor/app": "^6.0.3",
    "@capacitor/app-launcher": "^6.0.4",
    "@capacitor/cli": "^6.2.3",
    "@capacitor/core": "^6.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1"
  }
}
